<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CountdownDots" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#E4572E</item>
        <item name="android:windowBackground">#0C0C0E</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">#9A978F</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FieldButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:backgroundTint">#1C1B1F</item>
        <item name="android:textColor">#F2F0EA</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="FieldInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">#1C1B1F</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">#F2F0EA</item>
        <item name="android:textColorHint">#6E6C68</item>
    </style>

    <style name="Swatch">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/swatch_bg</item>
    </style>

    <style name="SwatchLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">#9A978F</item>
        <item name="android:textSize">10sp</item>
    </style>
</resources>
